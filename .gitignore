venv/
__pycache__/

# local Claude Code state; the CLAUDE.md symlink to AGENTS.md is tracked so a
# fresh clone gets the contributor contract without a manual setup step
.claude/*
!.claude/CLAUDE.md

*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# session handoffs -- local continuity notes, not project history
HANDOFF.md

# archived files from this branch's own orphan-reset and any future
# archive-not-delete moves -- not project history, see AGENTS.md convention
/archive/

# delegate-review artifacts -- evidence for a session, not project history
.orchestrator/

# scoring-sheet/report/leaderboard output (Tools 1/4/5) -- large, regenerable,
# per-run evidence, not project source; kept in a local checkout instead
# (operator may symlink reports/leaderboard to a synced cloud dir separately)
/results/
